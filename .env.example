# Credenciales de la instancia Neo4j AuraDB Free.
#
# NO llenes este archivo a mano. Al crear la instancia, Aura te ofrece
# descargar un archivo de credenciales que YA tiene este formato y que es
# correcto tal cual. Solo renombralo:
#
#     cp ~/Downloads/<archivo-de-aura> .env
#
# IMPORTANTE: no "corrijas" el usuario ni la base de datos. En AuraDB ambos
# se llaman como el ID de la instancia (p.ej. ab0cd36a), NO 'neo4j'.
# Verificado con SHOW DATABASES contra una instancia real: la unica base de
# usuario es la del ID, y no existe ninguna llamada 'neo4j'.
#
# Si perdiste el password, se regenera en console.neo4j.io -> la instancia
# -> Reset password. Ojo: un archivo descargado de una instancia que luego
# borraste ya no sirve, aunque la nueva tenga el mismo nombre.
#
# El archivo .env NUNCA se sube al repositorio (ver .gitignore).

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=xxxxxxxx
NEO4J_PASSWORD=tu-password-generado-por-aura
NEO4J_DATABASE=xxxxxxxx

# Informativos, el codigo no los usa:
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME=synth-id
